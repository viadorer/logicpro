# =====================================================================
# LogicPro — environment variables
# Zkopiruj do .env.local a vypln. .env.local NIKDY necommituj.
# Stejne hodnoty nastav i v Vercel project settings.
# =====================================================================

# ---- Supabase (server-side) — Vercel serverless funkce + scraper
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Supabase (client-side) — React app v prohlizeci
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Cloudflare Turnstile (spam protection inquiry formu)
# Vytvor site na https://dash.cloudflare.com/?to=/:account/turnstile
# Bez techto klicu je validace v dev rezimu (povoli vse, jen loguje warning).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ---- Vercel Cron (denni scraping)
# Vygeneruj nahodny token, napr. `openssl rand -hex 32`.
# Nastav v Vercel project settings; Vercel Cron automaticky posila
# `Authorization: Bearer ${CRON_SECRET}` na /api/cron/scrape.
CRON_SECRET=

# ---- Site URL (pro sitemap.xml a canonical odkazy)
PUBLIC_SITE_URL=https://logicpro.cz
VITE_SITE_URL=https://logicpro.cz

# ---- Data source feature flag — SERVER-SIDE (Vercel API handlery)
# Bezpecne pres env hot-swap (zadny rebuild). Klient nikdy nevidi.
# Mozne hodnoty:
#   'supabase'  (default — soucasna implementace, listings tabulka)
#   'nemovizor' (cely read pres Nemovizor API + property_extensions sidecar)
#   'hybrid'    (rezervovano)
DATA_SOURCE=supabase

# ---- Data source feature flag — CLIENT (legacy, ponechano pro kompatibilitu)
# Ovlivnuje jen src/lib/dataSource.js adapter wiring. V cilove architekture
# klient vzdy vola /api/* (proxy), takze tohle staci na 'supabase'.
VITE_DATA_SOURCE=supabase

# ---- Nemovizor API (server-side, BEZ VITE_ prefixu — klič nesmí do bundlu!)
# Production base: https://www.nemovizor.cz (bare domain redirektuje na www)
# Local dev (proti lokalnimu nemovizor-mvp): http://localhost:3000
NEMOVIZOR_API_URL=https://www.nemovizor.cz
NEMOVIZOR_API_KEY=
NEMOVIZOR_TIMEOUT_MS=10000

# ---- Nemovizor API (CLIENT) — zustava prazdne pro produkci.
# Nezadat zde API key! Pokud bys ho zde dal, je v client bundlu (DevTools readable).
VITE_NEMOVIZOR_API_URL=
VITE_NEMOVIZOR_API_KEY=
